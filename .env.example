# ---------------------------------------------------------------------------
# Elite Travel Hub — environment configuration
# Copy to .env (repo root) and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Public URL of the website (used for canonical links, sitemap and email links)
PUBLIC_SITE_URL=http://localhost:5173

# --- Database (Supabase Postgres) -----------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session pooler" or direct connection for a long-running Node server.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# true for Supabase cloud (TLS), false for the local Supabase stack
DATABASE_SSL=false

# --- Supabase Storage for vehicle photos (optional) ------------------------
# When both are set, uploaded photos go to a public Storage bucket.
# Otherwise they are stored on the server disk in UPLOAD_DIR.
# The service role key is a secret: server-side only, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vehicle-images
# UPLOAD_DIR=/var/lib/elite-travel-hub/uploads
UPLOAD_MAX_MB=8

# --- Email notifications (optional) ----------------------------------------
# Without SMTP, no emails are sent (the admin dashboard says so).
# For Gmail, use an App Password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Elite Travel Hub <elitetourandtravel2026@gmail.com>"
# Where new booking requests and enquiries are sent
BUSINESS_NOTIFY_EMAIL=elitetourandtravel2026@gmail.com

# --- Security / proxy -------------------------------------------------------
# Session lifetime for administrators
SESSION_TTL_HOURS=12
# Behind Nginx/a load balancer, set to the number of proxies (usually 1) so rate
# limiting sees real client IPs.
# TRUST_PROXY=1
# Cookies are Secure automatically when NODE_ENV=production; override if needed.
# COOKIE_SECURE=true
